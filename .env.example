NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/todo_list_management
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
API_KEY=replace-with-another-32-character-random-secret
BCRYPT_SALT_ROUNDS=12
CORS_ORIGINS=*

# Optional: isi di .env lokal saja saat menjalankan npm run seed:admin
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional: isi di .env lokal saja saat menjalankan npm run seed:demo
# SEED_USER_EMAIL=
